# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# OpenRouter API Key
OPENROUTER_API_KEY=your_openrouter_api_key

# Next.js App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature Flags
NEXT_PUBLIC_ENABLE_ILLUSTRATIONS=false
NEXT_PUBLIC_ENABLE_TRIVIA=true

# Default User Tier Configuration
# Set the default tier for new user signups (free, basic, pro)
DEFAULT_USER_TIER=pro

# Enable admin configuration of default tier via UI
# When true, admins can change default tier through admin dashboard
# When false, only environment variable is used
ENABLE_ADMIN_TIER_CONFIG=true
